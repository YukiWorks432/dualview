{
  "name": "dualview",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Open source side-by-side comparison tool for images, videos, audio files, and AI prompts",
  "repository": {
    "type": "git",
    "url": "https://github.com/YukiWorks432/dualview.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/vite": "^4.1.18",
    "clsx": "^2.1.1",
    "diff": "^8.0.3",
    "gif.js-upgrade": "^0.2.1",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "mp4-muxer": "^5.2.2",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.4.530",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
