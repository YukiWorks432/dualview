{
  "name": "dualview",
  "version": "1.0.0",
  "description": "Open source image and video A/B comparison tool for delivery review, with embedded video audio QA",
  "homepage": "https://dualview.hanayuki.xyz",
  "bugs": {
    "url": "https://github.com/YukiWorks432/dualview/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Gökay Aydoğan",
    "url": "https://github.com/gokayfem"
  },
  "contributors": [
    {
      "name": "花雪 / HanaYuki",
      "url": "https://hanayuki.xyz"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YukiWorks432/dualview.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "wrangler deploy",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mediabunny/prores": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gif.js-upgrade": "^0.2.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.66.0",
    "mediabunny": "^1.65.0",
    "pixelmatch": "^8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.75.0",
    "oxlint": "~1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
